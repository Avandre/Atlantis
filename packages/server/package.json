{
  "name": "@atlantis/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/index.ts",
    "build": "tsup src/index.ts --format esm --noExternal @atlantis/shared",
    "start": "node --env-file=../../.env dist/index.js",
    "typecheck": "tsc -p ."
  },
  "dependencies": {
    "@atlantis/shared": "*",
    "fastify": "^5.1.0",
    "pg": "^8.13.0",
    "socket.io": "^4.8.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/pg": "^8.11.10",
    "tsup": "^8.3.0",
    "tsx": "^4.19.0"
  }
}
