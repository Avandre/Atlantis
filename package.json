{
  "name": "atlantis",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "db:up": "docker compose up -d db",
    "dev": "concurrently -n server,client -c blue,green \"npm:dev -w @atlantis/server\" \"npm:dev -w @atlantis/client\"",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build -w @atlantis/client && npm run build -w @atlantis/server"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "typescript": "^5.6.0"
  }
}
